rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User Profiles Collection Security Rules
    // Only the authenticated user can read or write their own user profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Trips Collection Security Rules
    // Users can only read, update, or delete their own saved trips
    match /trips/{tripId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

  }
}
